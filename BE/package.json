{
  "name": "maianh-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js backend for the Mai Anh project",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "db:migrate:auth": "node --env-file-if-exists=.env scripts/migrate-auth.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10"
  }
}
